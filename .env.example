# ============================================================
# SIH26190 — Environment Configuration
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# ============================================================

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default for development)
# Uncomment and set for PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/sih26190

# Document Storage
DOCUMENT_STORAGE_PATH=./data/documents

# Encryption (Fernet symmetric key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DOCUMENT_ENCRYPTION_KEY=

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# AI / NLP
# Optional — if not set, system falls back to local spaCy + regex
GEMINI_API_KEY=
OPENAI_API_KEY=

# Blockchain (Hardhat / Ganache local node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Address of deployed DocumentIntegrity contract
BLOCKCHAIN_CONTRACT_ADDRESS=
# Private key of the account used to anchor hashes (dev account only, never real funds)
BLOCKCHAIN_ANCHOR_PRIVATE_KEY=

# spaCy model (downloaded separately: python -m spacy download en_core_web_sm)
SPACY_MODEL=en_core_web_sm

# Sentence-Transformers embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
